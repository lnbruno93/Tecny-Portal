---
/**
 * BaseLayout.astro — shell HTML de todas las páginas de la landing.
 *
 * Responsabilidades:
 *   1. <head> completo (meta, fonts preconnect, dataLayer init).
 *   2. Import de estilos globales (Tailwind + landing.css portado).
 *   3. Slot para el contenido de cada page.
 *
 * Slots:
 *   - default: contenido de la página.
 *   - head: <head> extra opcional (JSON-LD, meta overrides, etc.).
 *
 * Meta defaults se pueden overridear por page via props (title, description,
 * ogImage). Cuando NO se overridean, quedan los defaults de acá.
 */
import '../styles/global.css';
import '../styles/landing.css';
import MetaPixel from '../components/MetaPixel.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import ConsentBanner from '../components/ConsentBanner.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** noindex es útil en preview/dev; en producción queda indexable por default. */
  noindex?: boolean;
}

const {
  title = 'Tecny — El portal operativo para revendedores de tecnología',
  description = 'Cotizaciones, comprobantes con OCR, cuentas corrientes, envíos y caja en un solo lugar. Probá gratis 30 días.',
  ogImage = '/og-cover.png',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {/* Favicons — placeholders del Astro scaffold; en F5 se generan definitivos. */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    {/* Open Graph (Facebook, LinkedIn) */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tecny" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
    <meta property="og:locale" content="es_AR" />

    {/* Twitter Card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).toString()} />

    {/* Fonts — preconnect + Google Fonts stylesheet (mismo pattern que SPA
        actual, `frontend/index.html`). preconnect corta latencia del handshake
        TLS; el stylesheet trae solo los subsets latin de Inter + JetBrains Mono. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600;700&display=swap"
    />

    {/* dataLayer init — GTM/GA4/Meta Pixel pattern. Crea el array antes de
        que cualquier evento intente pushear, incluso si nada lo consume
        (Fase 4 conecta Pixel + GA4). El script inline es imprescindible
        (pattern estándar de GTM); CSP lo permite via nonce en Fase 4.
        Por ahora no hay CSP script-src activo así que corre sin problema.

        NOTA: Astro NO inline scripts que declara con <script is:inline> en
        el <head> del layout — los deja tal cual, sin bundle. Es lo que
        queremos: es 1 línea, no vale el fetch. */}
    <script is:inline>
      // eslint-disable-next-line no-undef
      window.dataLayer = window.dataLayer || [];

      // 2026-07-30 P0 hotfix: cleanup Service Worker residual.
      //
      // Contexto: antes de la migración a Astro (PRs #936/#937), tecnyapp.com
      // servía la SPA React del portal (frontend/) que registraba un Vite PWA
      // Service Worker via Workbox. Ese SW quedó vivo en los browsers de los
      // users que visitaron tecnyapp.com pre-migración — intercepta todos los
      // requests del dominio y devuelve responses cacheados de la SPA, que
      // ahora son INCOMPATIBLES con la landing Astro (rutas distintas, CSS
      // hashes distintos, etc.). Síntoma: users ven la landing sin estilos.
      //
      // Fix defensive: al cargar cualquier página del landing, desregistrar
      // TODOS los Service Workers activos + limpiar CacheStorage. Después
      // recargar la página una vez para que sirva sin SW interfiriendo.
      // La flag sessionStorage evita loop infinito (si el reload sigue con
      // SW activo por alguna razón, no volvemos a recargar).
      //
      // Long-term: el próximo deploy del portal puede setear un cleanup SW
      // vacío que se auto-desregistra. Este fix cubre a los que abren
      // tecnyapp.com/ directamente (landing) sin pasar por el portal.
      if ('serviceWorker' in navigator && !sessionStorage.getItem('sw_cleaned_v1')) {
        navigator.serviceWorker.getRegistrations().then(function(regs) {
          if (regs.length > 0) {
            sessionStorage.setItem('sw_cleaned_v1', '1');
            Promise.all([
              // Unregister todos los SW existentes.
              Promise.all(regs.map(function(r) { return r.unregister(); })),
              // Vaciar todas las cachés del CacheStorage.
              'caches' in window
                ? caches.keys().then(function(names) {
                    return Promise.all(names.map(function(n) { return caches.delete(n); }));
                  })
                : Promise.resolve(),
            ]).then(function() {
              // Reload para servir la página sin SW interfiriendo.
              window.location.reload();
            });
          }
        });
      }
    </script>

    {/* Meta Pixel (F4) — carga el snippet oficial + track PageView si
        consent OK. Va ANTES del slot head para que otros scripts puedan
        depender de window.fbq si lo necesitan. */}
    <MetaPixel />

    {/* Google Analytics 4 (F4) — gtag config + auto page_view. Mismo
        pattern condicional a consent. Comparte window.dataLayer con Pixel. */}
    <GoogleAnalytics />

    {/* Slot para <head> extra por page: JSON-LD, meta overrides, etc. */}
    <slot name="head" />
  </head>
  <body>
    <slot />

    {/* Consent banner (F4) — se renderea al final del body para que aparezca
        DESPUÉS del contenido principal. Solo visible la 1ra vez que el user
        entra al site (o cuando hace opt-in después de reset). */}
    <ConsentBanner />
  </body>
</html>
