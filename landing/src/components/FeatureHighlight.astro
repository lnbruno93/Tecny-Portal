---
/**
 * FeatureHighlight.astro — sección "Cotizá en segundos" con calculadora mock.
 *
 * Port de `frontend/src/screens/Landing.jsx:437-478`.
 * 100% estático — el mockup son valores fake para mostrar el look del Cotizador.
 */
---

<section class="s">
  <div class="wrap feat">
    <div>
      <div class="s-kicker">Cotizá en segundos</div>
      <h2 class="s-title">El precio listo<br />antes de que el cliente termine de escribir</h2>
      <p class="s-sub">Cargás el modelo, el dólar del día y el sistema arma todas las formas de pago. Copiás y enviás.</p>
      <div class="feat-list">
        <div class="feat-item">
          <div class="ck">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="Incluido">
              <path d="M5 12.5 10 17.5 20 7" />
            </svg>
          </div>
          <div>
            <h4>Contado, transferencia y cuotas</h4>
            <p>Cada forma con su recargo configurado, calculado en vivo.</p>
          </div>
        </div>
        <div class="feat-item">
          <div class="ck">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="Incluido">
              <path d="M5 12.5 10 17.5 20 7" />
            </svg>
          </div>
          <div>
            <h4>Texto listo para WhatsApp</h4>
            <p>Saludo, precios y cierre comercial — un clic y al portapapeles.</p>
          </div>
        </div>
        <div class="feat-item">
          <div class="ck">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="Incluido">
              <path d="M5 12.5 10 17.5 20 7" />
            </svg>
          </div>
          <div>
            <h4>Varios productos juntos</h4>
            <p>Armá una cotización con varios equipos y mostrá el total.</p>
          </div>
        </div>
      </div>
    </div>
    <div class="feat-visual">
      <div class="u-fw-600-fs-14-mb-4">iPhone 16 Pro · 256GB Natural</div>
      <div class="mono u-landing-calc-meta">USD 1.185 · TC $1.200</div>
      <div class="calc-row"><span class="l">Contado</span><span class="v u-color-pos">$1.422.000</span></div>
      <div class="calc-row"><span class="l">Transferencia (+3%)</span><span class="v u-color-pos">$1.464.660</span></div>
      <div class="calc-row"><span class="l">💳 3 cuotas (+23.5%)</span><span class="v u-color-accent">$1.756.170</span></div>
      <div class="calc-row"><span class="l">💳 6 cuotas (+28%)</span><span class="v u-color-accent">$1.820.160</span></div>
      <div class="calc-total"><span class="l u-landing-calc-total-label">6 × $303.360</span><span class="v">$1.820.160</span></div>
    </div>
  </div>
</section>
