---
/**
 * FeatureHighlight.astro — sección "Cotizá en segundos" con calculadora
 * mock estilo "cotizador en vivo".
 *
 * 2026-08-05 (feedback Lucas): rewrite del mock del cotizador para que
 * se lea como una réplica visual del cotizador real del portal (header
 * "COTIZADOR · EN VIVO" con badge verde "probalo acá", inputs visuales
 * de Equipo + Dólar, filas de cálculo, divider, total prominente,
 * botón "Copiar para WhatsApp"). Sin emojis en las filas — más limpio,
 * más profesional. Sin la lista de 3 features (checkmarks) que antes
 * competían con el mock; ahora el body es más corto y todo el peso
 * visual va al cotizador mock.
 *
 * Es un mock estático (no funcional) — los inputs son visuales, no
 * disparan cálculos. Los números son fake pero verosímiles.
 */
---

<section class="s">
  <div class="wrap feat">
    <div>
      <div class="s-kicker">Cotizá en segundos</div>
      <h2 class="s-title">El precio listo<br />antes de que el cliente termine de escribir</h2>
      <p class="s-sub">Cargás el modelo y el dólar del día, y el sistema arma todas las formas de pago con sus recargos. Copiás y enviás.</p>
      <p class="s-sub feat-sub-extra">Probalo acá al lado — es el cotizador real, con los recargos por cuota que vos configurás.</p>
    </div>
    <div class="feat-visual">
      {/* Header del mock: identifica que es el cotizador "en vivo" y
          señala visualmente que el usuario puede probarlo (dot verde + label).
          En este mock el badge es puramente decorativo — no dispara nada. */}
      <div class="calc-head">
        <div class="calc-title">COTIZADOR · EN VIVO</div>
        <div class="calc-live-badge"><span class="dot"></span>probalo acá</div>
      </div>

      {/* Inputs visuales del cotizador — no funcionales, solo mockup.
          Fake `<select>` con option único + fake `<input>` numérico.
          Estilo matchea el portal real (surface + border + accent al focus). */}
      <div class="calc-inputs">
        <div class="calc-field">
          <label>Equipo</label>
          <div class="calc-select">
            <span>iPhone 16 Pro · 256GB Natural</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </div>
        </div>
        <div class="calc-field calc-field-dollar">
          <label>Dólar</label>
          <div class="calc-input-mock">1200</div>
        </div>
      </div>

      <div class="calc-row"><span class="l">Contado</span><span class="v u-color-pos">$1.422.000</span></div>
      <div class="calc-row"><span class="l">Transferencia <span class="calc-badge">+3%</span></span><span class="v u-color-pos">$1.464.660</span></div>
      <div class="calc-row"><span class="l">3 cuotas <span class="calc-badge">+23,5%</span></span><span class="v u-color-accent">$1.756.170</span></div>
      <div class="calc-row"><span class="l">6 cuotas <span class="calc-badge">+28%</span></span><span class="v u-color-accent">$1.820.160</span></div>

      <div class="calc-divider"></div>

      <div class="calc-total"><span class="l u-landing-calc-total-label">6 × $303.360</span><span class="v">$1.820.160</span></div>

      {/* Botón "Copiar para WhatsApp" — visual solo, no funcional en el mock.
          En el portal real dispara `navigator.clipboard.writeText(...)` con el
          bloque de texto formateado para pegarlo directo en un chat de WA. */}
      <button type="button" class="calc-cta" data-cta="highlight:copy-wa" aria-label="Copiar cotización para pegar en WhatsApp (demo)">
        Copiar para WhatsApp
      </button>
    </div>
  </div>
</section>
