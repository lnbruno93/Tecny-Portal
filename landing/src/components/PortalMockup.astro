---
/**
 * PortalMockup.astro — mockup visual del portal Tecny con datos simulados
 * de un escenario "mes ganador" (47 ventas · USD 32.4K · +18% vs mes ant.).
 *
 * Extraído de Hero.astro el 2026-08-05 (task #306) para poder reusar
 * el mockup en distintos puntos de la landing sin duplicar HTML. En
 * cualquier sección donde se quiera mostrar la prueba visual del
 * producto, importar este componente y renderizarlo directamente.
 *
 * El markup usa las clases `.product-shot`, `.portal`, `.side*`,
 * `.top*`, `.main`, `.period-card`, `.section-h`, `.kpi*`, `.fab`,
 * `.chatb`, etc. definidas en `styles/landing.css` (bloque "Hero
 * portal mockup", grep `.tecny-landing .portal`). Sin `style={{}}`
 * inline — respeta guardrail CSP.
 *
 * Diseño validado por Lucas con mockup HTML local previo (decisión
 * durable 77 sobre mockups localhost).
 */
---

<div class="product-shot">
  <div class="shot-chrome">
    <span></span><span></span><span></span>
    <div class="shot-url">tecnyapp.com/resumen</div>
  </div>
  <div class="portal">
    <aside class="side">
      <div class="side-brand">
        <div class="brand-logo">T</div>
        <div class="brand-txt">
          <div class="n">Tecny</div>
          <div class="sub">Portal Operativo</div>
        </div>
      </div>
      <div class="side-body side-body-fade">
        <div class="side-cat">Comercial</div>
        <div class="side-item"><div class="ico"></div>Inicio</div>
        <div class="side-item active"><div class="ico"></div>Resumen del mes</div>
        <div class="side-item"><div class="ico"></div>Ventas</div>
        <div class="side-item"><div class="ico"></div>Venta &amp; Gestión B2B</div>
        <div class="side-item"><div class="ico"></div>Red B2B</div>
        <div class="side-item"><div class="ico"></div>Contactos</div>
        <div class="side-cat">Cajas y Proveedores</div>
        <div class="side-item"><div class="ico"></div>Cajas</div>
        <div class="side-item"><div class="ico"></div>Sanidad del Negocio</div>
        <div class="side-item"><div class="ico"></div>Conciliación bancaria</div>
        <div class="side-item"><div class="ico"></div>Inventario</div>
        <div class="side-item"><div class="ico"></div>Proveedores | Compras</div>
        <div class="side-cat">Opciones Financieras</div>
        <div class="side-item"><div class="ico"></div>Cambios de Divisa</div>
        <div class="side-item"><div class="ico"></div>Transferencias</div>
        <div class="side-item"><div class="ico"></div>Tarjetas de Crédito</div>
        <div class="side-cat">Otras herramientas</div>
        <div class="side-item"><div class="ico"></div>Cotizador</div>
        <div class="side-item"><div class="ico"></div>Usados y Cotizador</div>
        <div class="side-cat">Logística</div>
        <div class="side-item"><div class="ico"></div>Envíos</div>
        <div class="side-cat">Proyectos</div>
        <div class="side-item"><div class="ico"></div>Proyectos</div>
      </div>
      <div class="side-user">
        <div class="user-av">SF</div>
        <div class="user-info">
          <div class="n">Santiago Fernandez</div>
          <div class="r">Admin</div>
        </div>
        <div class="user-icons"><div class="ci"></div><div class="ci"></div></div>
      </div>
    </aside>

    <div class="portal-main">
      <div class="top">
        <span class="top-back">←</span>
        <span class="top-flag" aria-label="Argentina">🇦🇷</span>
        <span class="top-crumb">Portal / <span class="cur">Resumen del mes</span></span>
        <div class="top-search">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
          </svg>
          Buscar comprobantes, clientes, IMEI…
          <span class="kbd">⌘K</span>
        </div>
        <div class="bell" aria-label="Notificaciones"></div>
      </div>

      <div class="main">
        <h1 class="page-title">Resumen del mes</h1>
        <div class="page-sub">
          Comparativo de período + KPIs operativos consolidados.
          <span class="link">Ver gráficos →</span>
        </div>

        <div class="period-card">
          <span class="period-label">Período:</span>
          <span class="chip active">Este mes</span>
          <span class="chip">Mes pasado</span>
          <span class="chip">Hace 2 meses</span>
          <span class="chip">Personalizado</span>
          <span class="period-vs">vs</span>
          <span class="period-input">2026-07</span>
          <span class="period-vs">Agosto 2026 vs Julio 2026</span>
          <span class="period-tsp">Actualizado: 05/08/26 · 14:32</span>
        </div>

        <div class="section-h">Ventas</div>
        <div class="kpi-row">
          <div class="kpi"><div class="l">Ventas totales</div><div class="v"><span class="cur">USD</span>32.4K</div><div class="t">↗ +18% vs Julio</div></div>
          <div class="kpi"><div class="l">Ganancia bruta</div><div class="v"><span class="cur">USD</span>8.2K</div><div class="t">↗ +12% vs Julio</div></div>
          <div class="kpi"><div class="l">Ticket promedio</div><div class="v"><span class="cur">USD</span>689</div><div class="t">↗ +6% vs Julio</div></div>
          <div class="kpi"><div class="l">Cantidad de ventas</div><div class="v">47</div><div class="t">↗ +11 vs Julio</div></div>
        </div>

        <div class="section-h">Capital en cajas <span class="sub">(al fin del período)</span></div>
        <div class="kpi-row">
          <div class="kpi"><div class="l">Capital total</div><div class="v"><span class="cur">USD eq.</span>42.1K</div><div class="t mut">≈ igual</div></div>
          <div class="kpi"><div class="l">ARS</div><div class="v"><span class="cur">$</span>28.4M</div><div class="t">↗ +8.4%</div></div>
          <div class="kpi"><div class="l">USD</div><div class="v"><span class="cur">u$s</span>14.6K</div><div class="t">↗ +2.1%</div></div>
          <div class="kpi"><div class="l">USDT</div><div class="v">1.8K</div><div class="t mut">≈ igual</div></div>
        </div>

        <div class="section-h">Deudas y Egresos</div>
        <div class="kpi-row n3">
          <div class="kpi"><div class="l">Nos deben (CC clientes)</div><div class="v"><span class="cur">USD</span>5.4K</div><div class="t neg">↗ +18% vs Julio</div></div>
          <div class="kpi"><div class="l">Debemos (Proveedores)</div><div class="v"><span class="cur">USD</span>3.2K</div><div class="t">↘ −22% vs Julio</div></div>
          <div class="kpi"><div class="l">Egresos del mes</div><div class="v"><span class="cur">USD</span>4.8K</div><div class="t mut">≈ igual</div></div>
        </div>
      </div>
    </div>

    <div class="fab" aria-hidden="true">+</div>
    <div class="chatb" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3l1.5 4.5L18 9l-4.5 1.5L12 15l-1.5-4.5L6 9l4.5-1.5z"/>
        <path d="M18 15l.9 2.7L21 18.6l-2.1.9L18 22l-.9-2.5-2.1-.9 2.1-.9z"/>
      </svg>
    </div>
  </div>
</div>
