---
/**
 * CtaFinal.astro — sección CTA final antes del footer.
 *
 * Port de `frontend/src/screens/Landing.jsx:711-739`.
 *
 * Copy dinámico: `cta.headline` y `cta.body` vienen del CMS. Fallbacks
 * hardcoded matchean FALLBACK_CTA de Landing.hooks.js.
 */
import { calendlyHref } from '../lib/calendly';

const FALLBACK_CTA = {
  headline: 'Ordená tu negocio hoy',
  body:
    'Sumate a los equipos que ya dejaron las planillas atrás. Empezá gratis y mirá la diferencia en una semana.',
};
---

<section class="s">
  <div class="wrap">
    <div class="cta-final">
      <h2 id="cta-final-headline">{FALLBACK_CTA.headline}</h2>
      <p id="cta-final-body">{FALLBACK_CTA.body}</p>
      <div class="hero-actions">
        <a href="/signup" class="btn btn-primary btn-lg" data-cta="cta-final:signup">
          Empezá gratis
        </a>
        <a
          href={calendlyHref('cta-final')}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-lg"
          data-cta="cta-final:demo"
        >Agendá una demo</a>
      </div>
    </div>
  </div>
</section>

<script>
  import { apiUrl } from '../lib/api';
  import { reportLandingError } from '../lib/analytics';

  // Fetch site-config — el mismo endpoint que consume Faq.astro y Contacto.astro.
  // Backend cachea 300s → 3 fetches concurrentes al mount deduplican HTTP.
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), 8000);

  fetch(apiUrl('/api/public/site-config'), { signal: controller.signal })
    .then((res) => {
      if (!res.ok) throw new Error('http ' + res.status);
      return res.json();
    })
    .then((data) => {
      const cta = data?.cta;
      if (!cta || typeof cta !== 'object') return;
      const h = document.getElementById('cta-final-headline');
      const b = document.getElementById('cta-final-body');
      if (h && cta.headline) h.textContent = cta.headline;
      if (b && cta.body) b.textContent = cta.body;
    })
    .catch((err) => reportLandingError(err, { section: 'cta-final' }))
    .finally(() => clearTimeout(timer));
</script>
