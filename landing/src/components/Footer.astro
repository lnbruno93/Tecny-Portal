---
/**
 * Footer.astro — footer con brand + 4 columnas de links + copyright + social.
 *
 * Port de `frontend/src/screens/Landing.jsx:843-908`.
 *
 * SoonLink: en el SPA es `<span role="link" aria-disabled="true">`. Acá lo
 * inline como el mismo pattern — no vale un componente dedicado por 6 usages.
 *
 * 2026-08-06 (feedback Lucas): Instagram y WhatsApp del bloque social ahora
 * son links activos (no "próximamente"). Removido LinkedIn — Tecny no tiene
 * cuenta y "próximamente" indefinido es peor que no ofrecerlo. Los datos
 * (WA number, IG handle) matchean los del componente Contacto.astro y son
 * los mismos fallback que hidrata /api/public/site-config.
 */
import { buildWaLink } from '../lib/waLink';

// Matchea FALLBACK_CONTACT de Contacto.astro — mantener sincronizados.
const WA_NUMBER = '5491126165007';
const WA_MESSAGE = 'Hola! Me interesa Tecny. ¿Me pueden contar más?';
const IG_URL = 'https://instagram.com/tecny.app';
const waHref = buildWaLink(WA_NUMBER, WA_MESSAGE);
---

<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <div class="brand"><span class="mk">T</span> Tecny</div>
        <p class="foot-brand-blurb">
          El portal operativo para revendedores. Cotizá, cobrá, despachá y administrá — todo en una sola pantalla.
        </p>
      </div>

      <div class="foot-col">
        <h5>Producto</h5>
        <a href="#modulos">Módulos</a>
        <a href="#como">Cómo funciona</a>
        <a href="#precios">Precios</a>
        <span role="link" aria-disabled="true" title="Novedades — próximamente" class="u-landing-link-disabled">Novedades</span>
      </div>

      <div class="foot-col">
        <h5>Empresa</h5>
        <span role="link" aria-disabled="true" title="Sobre nosotros — próximamente" class="u-landing-link-disabled">Sobre nosotros</span>
        <a href="#contacto">Contacto</a>
        <span role="link" aria-disabled="true" title="Soporte — próximamente" class="u-landing-link-disabled">Soporte</span>
      </div>

      <div class="foot-col">
        <h5>Legal</h5>
        <a href="/terms">Términos</a>
        <a href="/privacy">Privacidad</a>
        <a href="/security">Seguridad</a>
      </div>
    </div>

    <div class="foot-bottom">
      <div class="cr">© 2026 Tecny · Buenos Aires, Argentina</div>
      <div class="soc">
        <a
          href={IG_URL}
          target="_blank"
          rel="noopener noreferrer"
          data-cta="footer:instagram"
          aria-label="Instagram de Tecny"
          title="Instagram"
        >
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5"/>
            <circle cx="12" cy="12" r="4"/>
            <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"/>
          </svg>
        </a>
        <a
          href={waHref}
          target="_blank"
          rel="noopener noreferrer"
          data-cta="footer:whatsapp"
          aria-label="WhatsApp de Tecny"
          title="WhatsApp"
        >
          {/* Ícono oficial de WhatsApp (mismo path que usa Contacto.astro y Hero.astro). */}
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.966-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.226 1.36.194 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
