---
/**
 * Contacto.astro — sección de contacto con WhatsApp, Email, Instagram, address.
 *
 * Port de `frontend/src/screens/Landing.jsx:741-841`.
 *
 * Fallbacks hardcoded (mismos valores que FALLBACK_CONTACT). El script client-
 * side hidrata desde /api/public/site-config si el admin cambió algún dato.
 *
 * Defensa XSS Instagram URL: en el hidrator validamos que sea http(s) antes
 * de setear el href — mismo criterio que la versión SPA (audit 2026-07-26).
 */
import { buildWaLink } from '../lib/waLink';

const FALLBACK_CONTACT = {
  email: 'hola@tecnyapp.com',
  whatsapp: '5491126165007',
  whatsapp_display: '+54 9 11 2616-5007',
  address: 'Buenos Aires, Argentina',
  // 2026-08-07: address_map_url null por default. Cuando el admin lo carga,
  // el card Ubicación se vuelve clickeable (hidrator lo up-grade de div a
  // link real vía el atributo href + target/rel).
  address_map_url: null as string | null,
  instagram_handle: 'tecny.app',
  instagram_url: 'https://instagram.com/tecny.app',
};

const initialWa = buildWaLink(
  FALLBACK_CONTACT.whatsapp,
  'Hola! Me interesa Tecny. ¿Me pueden contar más?'
);
---

<section class="s" id="contacto">
  <div class="wrap">
    <div class="s-head">
      <div class="s-kicker">Contacto</div>
      <h2 class="s-title">Hablá con nosotros</h2>
      <p class="s-sub">
        ¿Dudas antes de arrancar? ¿Necesitás algo específico para tu negocio?
        Escribinos por el canal que prefieras — respondemos en el día.
      </p>
    </div>
    <div class="contact-grid">
      {/* WhatsApp */}
      <a
        id="contact-whatsapp"
        href={initialWa}
        target="_blank"
        rel="noopener noreferrer"
        class="contact-card"
      >
        <div class="contact-icon" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.966-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.226 1.36.194 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
        </div>
        <div class="contact-body">
          <div class="contact-label">WhatsApp</div>
          <div class="contact-value" id="contact-whatsapp-display">{FALLBACK_CONTACT.whatsapp_display}</div>
          <div class="contact-hint">Respondemos en el día</div>
        </div>
      </a>

      {/* Email */}
      <a id="contact-email" href={`mailto:${FALLBACK_CONTACT.email}`} class="contact-card">
        <div class="contact-icon" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
        </div>
        <div class="contact-body">
          <div class="contact-label">Email</div>
          <div class="contact-value" id="contact-email-value">{FALLBACK_CONTACT.email}</div>
          <div class="contact-hint">Ideal para propuestas</div>
        </div>
      </a>

      {/* Instagram */}
      <a
        id="contact-instagram"
        href={FALLBACK_CONTACT.instagram_url}
        target="_blank"
        rel="noopener noreferrer"
        class="contact-card"
      >
        <div class="contact-icon" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
          </svg>
        </div>
        <div class="contact-body">
          <div class="contact-label">Instagram</div>
          <div class="contact-value" id="contact-instagram-handle">@{FALLBACK_CONTACT.instagram_handle}</div>
          <div class="contact-hint">Novedades del producto</div>
        </div>
      </a>

      {/* Ubicación — condicionalmente clickeable a Google Maps.
          Server-side: si NO hay address_map_url en el fallback, renderizamos
          un <a> sin href (HTML "placeholder link" — no clickable, sin cursor
          pointer via CSS). Si HAY URL, ya es un link real.
          Client-side: el hidrator promueve el <a> a link real si el backend
          devuelve una address_map_url válida (http/https) — o degrada a
          placeholder si el URL es inválido o el admin lo borró. */}
      <a
        id="contact-address-card"
        {...(FALLBACK_CONTACT.address_map_url
          ? { href: FALLBACK_CONTACT.address_map_url, target: '_blank', rel: 'noopener noreferrer' }
          : {})}
        class={`contact-card ${FALLBACK_CONTACT.address_map_url ? '' : 'contact-card-info'}`}
        aria-label="Ubicación"
      >
        <div class="contact-icon" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
        </div>
        <div class="contact-body">
          <div class="contact-label">Ubicación</div>
          <div class="contact-value" id="contact-address">{FALLBACK_CONTACT.address}</div>
          <div class="contact-hint" id="contact-address-hint">
            {FALLBACK_CONTACT.address_map_url ? 'Ver en Google Maps' : 'Reuniones a coordinar'}
          </div>
        </div>
      </a>
    </div>
  </div>
</section>

<script>
  import { apiUrl } from '../lib/api';
  import { reportLandingError } from '../lib/analytics';
  import { buildWaLink } from '../lib/waLink';

  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), 8000);

  fetch(apiUrl('/api/public/site-config'), { signal: controller.signal })
    .then((res) => {
      if (!res.ok) throw new Error('http ' + res.status);
      return res.json();
    })
    .then((data) => {
      const c = data?.contact;
      if (!c || typeof c !== 'object') return;

      // WhatsApp — el card completo apunta al wa.me; también actualizamos el
      // display debajo. Fallbacks del server render si algún campo viene null.
      if (c.whatsapp) {
        const wa = document.getElementById('contact-whatsapp') as HTMLAnchorElement | null;
        if (wa) wa.href = buildWaLink(c.whatsapp, 'Hola! Me interesa Tecny. ¿Me pueden contar más?');
      }
      if (c.whatsapp_display) {
        const el = document.getElementById('contact-whatsapp-display');
        if (el) el.textContent = c.whatsapp_display;
      }

      // Email — actualizamos href mailto: y el texto.
      if (c.email) {
        const emailAnchor = document.getElementById('contact-email') as HTMLAnchorElement | null;
        const emailText = document.getElementById('contact-email-value');
        if (emailAnchor) emailAnchor.href = `mailto:${c.email}`;
        if (emailText) emailText.textContent = c.email;
      }

      // Instagram — XSS defensivo: solo aceptamos http(s). Otro schema (ej.
      // javascript:) queda con el fallback. Backend valida con Zod pero
      // defense-in-depth acá tampoco molesta (audit 2026-07-26).
      //
      // 2026-08-07: agregado fallback defensivo — si el URL viene incompleto
      // (ej. "https://instagram.com/" sin el handle, bug real reportado por
      // Lucas donde el admin cargó handle y borró el URL), construimos el
      // URL desde el handle. La regla: el URL debe contener el handle
      // (case-insensitive). Si no matchea o está vacío pero hay handle,
      // reconstruimos: `https://instagram.com/{handle}`.
      const ig = document.getElementById('contact-instagram') as HTMLAnchorElement | null;
      const handle = typeof c.instagram_handle === 'string' ? c.instagram_handle.trim() : '';
      const urlFromServer = typeof c.instagram_url === 'string' ? c.instagram_url.trim() : '';
      const urlHasHandle = handle && urlFromServer.toLowerCase().includes(handle.toLowerCase());
      let finalIgUrl: string | null = null;
      if (urlFromServer && /^https?:\/\//i.test(urlFromServer) && (urlHasHandle || !handle)) {
        finalIgUrl = urlFromServer;
      } else if (handle && /^[a-zA-Z0-9._]{1,30}$/.test(handle)) {
        // Reconstruir desde el handle (regex matchea IG_HANDLE_RE del backend).
        finalIgUrl = `https://instagram.com/${handle}`;
      }
      if (ig && finalIgUrl) ig.href = finalIgUrl;

      if (c.instagram_handle) {
        const el = document.getElementById('contact-instagram-handle');
        if (el) el.textContent = `@${c.instagram_handle}`;
      }

      // Address (texto)
      if (c.address) {
        const el = document.getElementById('contact-address');
        if (el) el.textContent = c.address;
      }

      // Address → Google Maps link.
      // Promocionamos el <a> a link real si viene URL válida http(s).
      // Si no viene URL, dejamos el <a> sin href (placeholder no clickeable).
      // XSS defensivo: mismo criterio que instagram_url — solo http(s).
      const addrCard = document.getElementById('contact-address-card') as HTMLAnchorElement | null;
      const addrHint = document.getElementById('contact-address-hint');
      const mapUrl = typeof c.address_map_url === 'string' ? c.address_map_url.trim() : '';
      if (addrCard) {
        if (mapUrl && /^https?:\/\//i.test(mapUrl)) {
          addrCard.href = mapUrl;
          addrCard.target = '_blank';
          addrCard.rel = 'noopener noreferrer';
          addrCard.classList.remove('contact-card-info');
          if (addrHint) addrHint.textContent = 'Ver en Google Maps';
        } else {
          // Admin borró el URL → degradar a placeholder si venía con fallback.
          addrCard.removeAttribute('href');
          addrCard.removeAttribute('target');
          addrCard.removeAttribute('rel');
          addrCard.classList.add('contact-card-info');
          if (addrHint) addrHint.textContent = 'Reuniones a coordinar';
        }
      }
    })
    .catch((err) => reportLandingError(err, { section: 'contact' }))
    .finally(() => clearTimeout(timer));
</script>
