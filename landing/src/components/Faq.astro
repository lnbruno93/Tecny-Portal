---
/**
 * Faq.astro — sección "Preguntas frecuentes" con <details> nativos.
 *
 * Port de `frontend/src/screens/Landing.jsx:686-709`.
 *
 * Renderizamos los 7 defaults hardcoded (mismos que FALLBACK_FAQ) y el
 * script inline abajo reemplaza la lista con los del CMS si Lucas cargó
 * overrides desde admin.tecnyapp.com/sitio-publico.
 *
 * Primer item abierto por default (patrón <details open>).
 */

/* 2026-08-05 (feedback Lucas): rewrite completo del FAQ con nuevo orden
   (7 preguntas — antes 6). Cambios respecto a la versión anterior:
     · Nueva pregunta 01: onboarding sin migración dolorosa (destraba una
       de las objeciones más frecuentes de un revendedor con Excel viejo).
     · Nueva pregunta 02: compatibilidad multi-marca (destraba la duda
       "¿esto es solo para iPhone?" que aparece porque el copy de la
       landing y del catálogo usa iPhone en los mocks).
     · Reordenadas: onboarding + marcas primero (info que la gente busca
       antes de decidir), después permisos, monedas, OCR, instalación,
       y cierre con "¿qué pasa al terminar los 30 días?" (que reemplaza
       la vieja "¿Ofrecen prueba gratis?" — ya se asume que hay prueba;
       ahora respondemos qué pasa cuando termina).
     · Removida: "¿Qué pasa con mis datos si dejo de usarlo?" — ya está
       cubierta por la nueva sección `TusDatos` (backups + export + soft-
       delete) que vive antes del FAQ.
     · Título de la 05 sin "(OCR)" — más humano, menos jerga técnica. */
const FALLBACK_FAQ = [
  {
    id: 'default-1',
    question: '¿Tengo que cargar todo mi stock de nuevo?',
    answer:
      'No. Empezás a usarlo con el próximo equipo que entra y el sistema va armando la foto del negocio a medida que cargás. Si querés subir tu planilla de una, la importás en un archivo y te damos una mano.',
  },
  {
    id: 'default-2',
    question: '¿Sirve solo para iPhone o también para otras marcas?',
    answer:
      'Sirve para cualquier equipo con IMEI: iPhone, Samsung, Xiaomi, Motorola, tablets, smartwatches. Los ejemplos y catálogos que ves usan iPhone porque es lo más habitual en el rubro, pero cargás cualquier marca y modelo y funciona igual.',
  },
  {
    id: 'default-3',
    question: '¿Mis vendedores van a ver toda la información?',
    answer:
      'Vos decidís. Cada usuario tiene permisos por módulo: podés darle acceso solo al Cotizador y Envíos, por ejemplo, mientras que la parte financiera y de caja queda reservada para administradores.',
  },
  {
    id: 'default-4',
    question: '¿Puedo manejar pesos y dólares?',
    answer:
      'Sí. Cuentas corrientes, cajas, comprobantes y catálogo de usados manejan ARS y USD por separado, sin mezclarlos. El cotizador convierte con el tipo de cambio que vos cargues.',
  },
  {
    id: 'default-5',
    question: '¿Cómo funciona el lector de comprobantes?',
    answer:
      'Sacás una foto del comprobante de pago o subís el PDF, y el sistema detecta el monto automáticamente con inteligencia artificial. Si la confianza es alta, queda pre-cargado; si no, te avisa para que lo revises. Aceptamos JPG, PNG, WEBP y PDF de hasta 5 MB.',
  },
  {
    id: 'default-6',
    question: '¿Necesito instalar algo?',
    answer:
      'No. Tecny funciona desde el navegador, en la compu o el celular. Creás tu cuenta y empezás a usarlo en minutos, sin descargas ni configuración técnica.',
  },
  {
    id: 'default-7',
    question: '¿Qué pasa cuando terminan los 30 días?',
    answer:
      'Elegís el plan que te sirve y seguís con toda tu data intacta. Si preferís no seguir, tu cuenta pausa y podés exportar todo desde el sistema antes de que se archive. Nada se borra sin avisarte primero.',
  },
] as const;
---

<section class="s" id="faq">
  <div class="wrap">
    {/* 2026-08-05 (feedback Lucas): FAQ es la ÚNICA sección con head
        centrado. El resto de la landing va alineada a la izquierda
        (decisión durable de este mismo día). Excepción a la regla:
        el FAQ funciona visualmente mejor centrado — hace de "puente"
        entre el bloque de conversión (Tus Datos → Precios) y el
        CTA Final. La clase `.center` (aplicada en el CSS con
        `text-align: center` + `margin: 0 auto`) invierte solo
        para esta sección. */}
    <div class="s-head center">
      <div class="s-kicker">Preguntas frecuentes</div>
      <h2 class="s-title">Lo que todos preguntan</h2>
    </div>
    <div class="faq" id="faq-list">
      {FALLBACK_FAQ.map((q, i) => (
        <details class="qa" open={i === 0}>
          <summary>
            {q.question}
            <svg class="pm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M12 5v14M5 12h14"/>
            </svg>
          </summary>
          <div class="a">{q.answer}</div>
        </details>
      ))}
    </div>
  </div>
</section>

<script>
  import { apiUrl } from '../lib/api';
  import { reportLandingError } from '../lib/analytics';

  // El fetch de FAQ va junto con el resto de site-config (contacto, hero, cta)
  // pero para evitar duplicar el fetch en 3 componentes, cada componente hace
  // el suyo propio. Cache HTTP 300s del backend deduplica la mayoría.
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), 8000);

  fetch(apiUrl('/api/public/site-config'), { signal: controller.signal })
    .then((res) => {
      if (!res.ok) throw new Error('http ' + res.status);
      return res.json();
    })
    .then((data) => {
      const faq = Array.isArray(data?.faq) ? data.faq : [];
      if (faq.length === 0) return; // mantiene fallbacks

      const list = document.getElementById('faq-list');
      if (!list) return;

      // Escape HTML defensivo — el admin edita en textarea sin sanitizer.
      // React (SPA) escapa automáticamente; acá lo hacemos manual.
      const escape = (s: string) =>
        s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

      list.innerHTML = faq
        .map((q: { id?: string; question: string; answer: string }, i: number) => {
          const open = i === 0 ? ' open' : '';
          return (
            `<details class="qa"${open}>
              <summary>
                ${escape(q.question)}
                <svg class="pm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <path d="M12 5v14M5 12h14"/>
                </svg>
              </summary>
              <div class="a">${escape(q.answer)}</div>
            </details>`
          );
        })
        .join('');
    })
    .catch((err) => reportLandingError(err, { section: 'faq' }))
    .finally(() => clearTimeout(timer));
</script>
