---
/**
 * TrustedCompanies.astro — carrusel infinito de logos de empresas.
 *
 * Port de `frontend/src/screens/Landing.jsx:629-684` + useTrustedCompanies.
 *
 * Estrategia: renderizamos la sección OCULTA por default (hidden). El script
 * client-side hace fetch a /api/public/trusted-companies y si vienen logos,
 * muestra la sección y monta el marquee. Si viene vacío o el fetch falla,
 * la sección queda hidden — fail-open, cero placeholder feo.
 *
 * Duplicación de logos (set A + set B) para el loop seamless — se hace en JS
 * al hidratar, no en el server render (donde no sabemos los N logos).
 */
---

<section class="s trusted" id="empresas" hidden data-trusted-section>
  <div class="wrap">
    <div class="s-head">
      <div class="s-kicker">Confían en nosotros</div>
      <h2 class="s-title">Empresas que confiaron en Tecny</h2>
      <p class="s-sub">
        Comercios y equipos que ya ordenaron su operación con nosotros.
      </p>
    </div>
    <div class="trusted-track-wrap" aria-label="Empresas que confiaron en Tecny">
      <div class="trusted-track" role="list" id="trusted-track"></div>
    </div>
  </div>
</section>

<script>
  import { apiUrl, BACKEND_BASE } from '../lib/api';
  import { reportLandingError } from '../lib/analytics';

  interface Company {
    id: number;
    nombre: string;
    position?: number;
  }

  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), 8000);

  fetch(apiUrl('/api/public/trusted-companies'), { signal: controller.signal })
    .then((res) => {
      if (!res.ok) throw new Error('http ' + res.status);
      return res.json() as Promise<{ companies?: Company[] }>;
    })
    .then((data) => {
      const companies = Array.isArray(data?.companies) ? data.companies : [];
      if (companies.length === 0) return; // fail-open: sección se queda hidden

      const section = document.querySelector<HTMLElement>('[data-trusted-section]');
      const track = document.getElementById('trusted-track');
      if (!section || !track) return;

      // Duplicamos el array (set A + set B) para el loop seamless del marquee.
      // Set B tiene aria-hidden="true" para que screen readers no lean 2× la
      // lista completa — el marquee es puramente visual.
      const html = [...companies, ...companies]
        .map((c, i) => {
          const isSetB = i >= companies.length;
          const ariaHidden = isSetB ? ' aria-hidden="true"' : '';
          const src = `${BACKEND_BASE}/api/public/trusted-companies/${c.id}/logo`;
          const nombreEscaped = c.nombre.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
          return (
            `<div class="trusted-logo" role="listitem"${ariaHidden} title="${nombreEscaped}" data-logo-id="${c.id}" data-is-set-b="${isSetB}">
              <img src="${src}" alt="${nombreEscaped}" loading="lazy" />
            </div>`
          );
        })
        .join('');
      track.innerHTML = html;
      section.hidden = false;

      // Wire onerror para reportar logos rotos (solo set A — evita doble reporte).
      track.querySelectorAll<HTMLImageElement>('img').forEach((img) => {
        const parent = img.closest<HTMLElement>('.trusted-logo');
        if (!parent || parent.dataset.isSetB === 'true') return;
        img.addEventListener('error', () => {
          reportLandingError(new Error('trusted_company_logo_failed'), {
            section: 'trusted-companies',
            logo_id: parent.dataset.logoId || null,
          });
        });
      });
    })
    .catch((err) => reportLandingError(err, { section: 'trusted-companies' }))
    .finally(() => clearTimeout(timer));
</script>
