---
/**
 * Hero.astro — sección hero con headline, blurb, CTAs y mockup del portal.
 *
 * Port de `frontend/src/screens/Landing.jsx:203-284`.
 *
 * Copy dinámico: hero.headline/subheadline/blurb vienen del CMS backend en
 * la versión SPA. En Astro SSG NO tenemos ese fetch al build (sería SSR).
 * Estrategia F2: renderizamos los fallbacks estáticos + hidratamos client-side
 * con un fetch al mount si el CMS backend tiene overrides.
 *
 * Trade-off: la primera vista (LCP) usa el fallback estático — que en 99% de
 * los casos es lo que Lucas quiere mostrar. Si edita desde admin, el override
 * aparece con delay <500ms (fetch backend). Aceptable para F2 — en F5 podemos
 * mover a build-time fetch con webhook Netlify si Lucas cambia copy seguido.
 *
 * Los CTAs del hero — "Empezá gratis" (a /signup) y "Ver cómo funciona" (scroll
 * anchor) — mantienen el pattern data-cta que wire-ea el listener global.
 *
 * NOTA sobre el mockup: hardcoded 1:1 con la landing actual (no vino ninguna
 * refactor request). Es SVG + text inline — 0 JS, cero fetch.
 */

// Fallbacks — mismos que FALLBACK_HERO de Landing.hooks.js
const HERO_FALLBACK = {
  headline: 'Todo tu negocio, en una sola pantalla.',
  blurb:
    'Cotizaciones, comprobantes, cuentas corrientes, envíos y caja — para equipos que venden tecnología. Dejá las planillas sueltas y los grupos de WhatsApp: Tecny ordena la operación de toda tu mesa de trabajo.',
};
---

<header class="hero">
  <div class="wrap hero-grid">
    <div>
      <div class="eyebrow">
        <span class="dot"></span> El portal operativo para revendedores
      </div>

      {/* Headline con el highlight en la segunda parte — matchea el markup del
          SPA. El fetch client-side abajo puede reemplazar el innerHTML del h1
          si el CMS tiene override. */}
      <h1 class="hero-h" id="hero-headline">
        Todo tu negocio,<br /><span class="hl">en una sola pantalla.</span>
      </h1>

      <p class="hero-sub u-landing-hero-sub" id="hero-subheadline" hidden></p>
      <p class="hero-sub" id="hero-blurb">{HERO_FALLBACK.blurb}</p>

      <div class="hero-actions">
        <a href="/signup" class="btn btn-primary btn-lg" data-cta="hero:signup">
          Empezá gratis
        </a>
        <a href="#como" class="btn btn-lg" data-cta="hero:scroll-como">
          Ver cómo funciona
        </a>
      </div>

      <div class="hero-note">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12.5 10 17.5 20 7" />
        </svg>
        Sin tarjeta · listo en minutos · soporte en español
      </div>
    </div>

    {/* Product window — mockup del portal, idéntico al SPA */}
    <div class="product-shot">
      <div class="shot-chrome">
        <span></span><span></span><span></span>
        <div class="shot-url">app.tecnyapp.com/inicio</div>
      </div>
      <div class="shot-body">
        <div class="shot-side">
          <div class="sb"><span class="m">T</span> Tecny</div>
          <div class="sh">Herramientas</div>
          <div class="si on"><span class="d"></span>Inicio</div>
          <div class="si"><span class="d"></span>Cotizador</div>
          <div class="si"><span class="d"></span>Financiera</div>
          <div class="si"><span class="d"></span>Cajas</div>
          <div class="si"><span class="d"></span>Envíos</div>
          <div class="si"><span class="d"></span>Cuentas CC</div>
        </div>
        <div class="shot-main">
          <div class="shot-h">Buen día, Lucas</div>
          <div class="shot-hsub">Martes 23 de mayo · 18 comprobantes hoy</div>
          <div class="shot-kpis">
            <div class="shot-kpi"><div class="l">Comprobantes</div><div class="v">18</div><div class="t">↗ +6</div></div>
            <div class="shot-kpi"><div class="l">Cobrado neto</div><div class="v">13,06M</div><div class="t">↗ +12.4%</div></div>
            <div class="shot-kpi"><div class="l">Saldo CC</div><div class="v">14,28M</div><div class="t u-color-muted">−3.1%</div></div>
            <div class="shot-kpi"><div class="l">Envíos</div><div class="v">7</div><div class="t">↗ +1</div></div>
          </div>
          <div class="shot-row">
            <div><div class="nm">Mac Center · #F-0421</div><div class="meta">Camila R. · Transferencia</div></div>
            <div class="u-text-right"><div class="amt">ARS 4.280.000</div><span class="pill pill-pos">OCR 96%</span></div>
          </div>
          <div class="shot-row">
            <div><div class="nm">Celular Express · #F-0420</div><div class="meta">Sofía P. · Depósito</div></div>
            <div class="u-text-right"><div class="amt">ARS 1.840.000</div><span class="pill pill-amber">Pendiente</span></div>
          </div>
          <div class="shot-row">
            <div><div class="nm">iStore Norte · #F-0419</div><div class="meta">Lucas I. · USD efectivo</div></div>
            <div class="u-text-right"><div class="amt">USD 12.500</div><span class="pill pill-pos">OCR 95%</span></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>
