---
/**
 * Modulos.astro — sección "Módulos" con las 6 features del producto.
 *
 * Port de `frontend/src/screens/Landing.jsx:358-435`.
 * Los SVGs son inline — mismo diseño 1:1 que el SPA. Los `tint-*` viven en
 * landing.css (`tint-amber`, `tint-blue`, `tint-green`, `tint-purple`,
 * `tint-cyan`, `tint-pink`) y matchean colores del design system.
 */

const MODULOS = [
  {
    tint: 'tint-amber',
    title: 'Cotizador',
    body: 'Precios al instante con tipo de cambio, recargos por cuota y formas de pago. Copiás el texto y lo mandás por WhatsApp.',
    iconKey: 'cotizador',
  },
  {
    tint: 'tint-blue',
    title: 'Financiera',
    body: 'Cargá comprobantes con foto, el OCR detecta el monto y calcula la retención automáticamente. Pagos y vendedores en un solo lugar.',
    iconKey: 'financiera',
  },
  {
    tint: 'tint-green',
    title: 'Cajas',
    body: 'Deudas e inversiones por contacto, en pesos y dólares por separado. Sabés con exactitud qué entra, qué sale y a quién.',
    iconKey: 'cajas',
  },
  {
    tint: 'tint-purple',
    title: 'Envíos',
    body: 'Despachos a domicilio con prioridad, horario y operador. Cada envío lleva productos con IMEI y cobros a realizar en la entrega.',
    iconKey: 'envios',
  },
  {
    tint: 'tint-cyan',
    title: 'Cuentas CC',
    body: 'Clientes B2B con categorías VIP, A+ y A-. Compras, pagos, devoluciones y entregas con detalle de IMEI verificado por item.',
    iconKey: 'cuentascc',
  },
  {
    tint: 'tint-pink',
    title: 'Usados',
    body: 'Catálogo de precios en USD editable como una planilla. Actualizá decenas de modelos de una vez y mantené la tabla al día.',
    iconKey: 'usados',
  },
] as const;
---

<section class="s u-bar-y-hairline" id="modulos">
  <div class="wrap">
    <div class="s-head">
      <div class="s-kicker">Los módulos</div>
      <h2 class="s-title">Una herramienta para cada parte del negocio</h2>
      <p class="s-sub">Siete módulos que conversan entre sí. Activá los que necesitás, sumá el resto cuando crezcas.</p>
    </div>
    <div class="mods">
      {MODULOS.map((mod) => (
        <div class="mod">
          <div class={`ico ${mod.tint}`}>
            {mod.iconKey === 'cotizador' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <rect x="4" y="3" width="16" height="18" rx="2.5"/>
                <rect x="7" y="6.5" width="10" height="3.5" rx="0.6"/>
                <circle cx="8.5" cy="13.5" r="0.7" fill="currentColor"/>
                <circle cx="12" cy="13.5" r="0.7" fill="currentColor"/>
                <circle cx="15.5" cy="13.5" r="0.7" fill="currentColor"/>
              </svg>
            )}
            {mod.iconKey === 'financiera' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 17 9 11l4 4 8-9"/><path d="M14 6h7v7"/>
              </svg>
            )}
            {mod.iconKey === 'cajas' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 8H6a3 3 0 0 1 0-6h13v6Z"/>
                <path d="M3 5v13a3 3 0 0 0 3 3h15V8"/>
                <circle cx="17" cy="14" r="1.4" fill="currentColor"/>
              </svg>
            )}
            {mod.iconKey === 'envios' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 7h11v9H2z"/>
                <path d="M13 10h4l4 4v2h-8"/>
                <circle cx="7" cy="18" r="2"/>
                <circle cx="17.5" cy="18" r="2"/>
              </svg>
            )}
            {mod.iconKey === 'cuentascc' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 3v18l2-1.5L9 21l2-1.5L13 21l2-1.5L17 21l2-1.5V3l-2 1.5L15 3l-2 1.5L11 3 9 4.5 7 3 5 4.5Z"/>
                <path d="M8.5 8h7M8.5 12h7"/>
              </svg>
            )}
            {mod.iconKey === 'usados' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <rect x="6" y="2" width="12" height="20" rx="2.5"/>
                <path d="M10 5h4"/>
                <circle cx="12" cy="18" r="0.8" fill="currentColor"/>
              </svg>
            )}
          </div>
          <h3>{mod.title}</h3>
          <p>{mod.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
