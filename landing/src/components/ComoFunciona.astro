---
/**
 * ComoFunciona.astro — sección "Cómo funciona" con 4 steps.
 *
 * Port de `frontend/src/screens/Landing.jsx:301-356`.
 * Contenido puramente estático — 100% SSG-friendly.
 */

/* 2026-08-05: copy nuevo pedido por Lucas — foco en el flow real del
   revendedor tecno (carga inventario → registra venta → ve saldos vivos
   → mira el mes) en lugar del copy genérico "creá tu equipo / controlá
   todo". Cada paso muestra el value prop concreto (IMEI + cotización
   con dólar del día + cuentas corrientes en pesos y dólares + margen
   por categoría). Iconos remapeados semánticamente: caja (inventario),
   recibo (venta), trending-up (saldos), bar-chart (métricas mes). */
const STEPS = [
  {
    n: '01',
    title: 'Cargá el inventario',
    body: 'Modelo, IMEI, costo y proveedor. Cada equipo tiene su ficha desde que entra y sabés cuánto vale tu stock.',
    icon: 'inventario',
  },
  {
    n: '02',
    title: 'Registrá la venta',
    body: 'Cotizás con el dólar del día, cerrás y el IMEI sale del stock solo. Nunca más vendés dos veces el mismo equipo.',
    icon: 'venta',
  },
  {
    n: '03',
    title: 'Seguí los saldos',
    body: 'Caja y cuentas corrientes se actualizan en vivo, en pesos y en dólares. Sabés siempre quién te debe y cuánto.',
    icon: 'saldos',
  },
  {
    n: '04',
    title: 'Mirá cómo va el mes',
    body: 'Facturación, margen neto y qué categoría te deja más profit. Con la comparación contra el mes anterior.',
    icon: 'metricas',
  },
] as const;
---

<section class="s u-bar-y-hairline" id="como">
  <div class="wrap">
    <div class="s-head">
      <div class="s-kicker">Cómo funciona</div>
      <h2 class="s-title">El equipo entra, se vende y el stock se ajusta solo</h2>
      <p class="s-sub">Sin migración dolorosa. Cargás tu primer equipo y desde ahí el sistema lleva la cuenta.</p>
    </div>
    <div class="steps" id="steps-list">
      {STEPS.map((step) => (
        <div class="step">
          <div class="n">{step.n}</div>
          <div class="ico">
            {step.icon === 'inventario' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 8v13H3V8"/><path d="M1 3h22v5H1z"/><path d="M10 12h4"/>
              </svg>
            )}
            {step.icon === 'venta' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 2h12l4 4v14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"/><path d="M16 2v4h4"/><path d="M8 11h8M8 15h5"/>
              </svg>
            )}
            {step.icon === 'saldos' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 17 9 11l4 4 8-9"/><path d="M14 6h7v7"/>
              </svg>
            )}
            {step.icon === 'metricas' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 3v18h18"/><path d="M8 17V11"/><path d="M13 17V6"/><path d="M18 17v-4"/>
              </svg>
            )}
          </div>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </div>
      ))}
    </div>

    {/* Callout con la respuesta a "¿y si tengo vendedores?" — pregunta que
        Lucas identificó como bloqueadora frecuente en demos. Diseño
        low-key (borde sutil, mismo bg) para no competir con los steps. */}
    <div class="como-callout">
      <strong>¿Trabajás con vendedores?</strong> Sumalos cuando quieras, con permisos por módulo:
      uno puede cotizar sin ver la caja, los márgenes ni las deudas de otros clientes. Si trabajás
      solo, no configurás nada.
    </div>
  </div>
</section>

<script>
  /**
   * Hidratación CMS — reemplaza los STEPS hardcoded si el admin cargó
   * overrides. Los 4 SVG icons quedan hardcoded acá (CMS solo persiste
   * la iconKey string).
   */
  import { apiUrl } from '../lib/api';
  import { reportLandingError } from '../lib/analytics';

  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), 8000);

  type Step = { id?: string; n: string; title: string; body: string; icon: string };

  const ICONS: Record<string, string> = {
    inventario: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8v13H3V8"/><path d="M1 3h22v5H1z"/><path d="M10 12h4"/></svg>',
    venta: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 2h12l4 4v14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"/><path d="M16 2v4h4"/><path d="M8 11h8M8 15h5"/></svg>',
    saldos: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17 9 11l4 4 8-9"/><path d="M14 6h7v7"/></svg>',
    metricas: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M8 17V11"/><path d="M13 17V6"/><path d="M18 17v-4"/></svg>',
  };

  fetch(apiUrl('/api/public/site-config'), { signal: controller.signal })
    .then((res) => {
      if (!res.ok) throw new Error('http ' + res.status);
      return res.json();
    })
    .then((data) => {
      const steps: Step[] = Array.isArray(data?.como_funciona) ? data.como_funciona : [];
      if (steps.length === 0) return; // mantiene fallback SSR

      const list = document.getElementById('steps-list');
      if (!list) return;

      const escape = (s: string) =>
        s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

      list.innerHTML = steps
        .map((step) => {
          const iconSvg = ICONS[step.icon] || '';
          return (
            `<div class="step">` +
            `<div class="n">${escape(step.n)}</div>` +
            `<div class="ico">${iconSvg}</div>` +
            `<h3>${escape(step.title)}</h3>` +
            `<p>${escape(step.body)}</p>` +
            `</div>`
          );
        })
        .join('');
    })
    .catch((err) => reportLandingError(err, { section: 'como_funciona' }))
    .finally(() => clearTimeout(timer));
</script>
