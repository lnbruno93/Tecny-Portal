---
/**
 * Home de tecnyapp.com — landing pública.
 *
 * Ensambla las 10 secciones portadas de `frontend/src/screens/Landing.jsx`
 * a componentes Astro:
 *   1. Nav (sticky con brand + links internos + CTAs)
 *   2. Hero (headline + blurb + mockup del portal)
 *   3. ComoFunciona (4 steps)
 *   4. Modulos (6 features del producto)
 *   5. FeatureHighlight (Cotizador con calculadora mock)
 *   6. Precios (4 planes, fetch dinámico)
 *   7. TrustedCompanies (carrusel, oculto si vacío)
 *   8. Faq (6 defaults + hidratable desde CMS)
 *   9. CtaFinal (CTA final antes del footer, texto editable)
 *  10. Contacto (WhatsApp + Email + IG + address editables)
 *  11. Footer
 *
 * TODO tiene que estar envuelto en <div class="tecny-landing"> — los
 * selectores de `landing.css` están scoped a esa clase (var(--accent),
 * var(--muted), etc. viven ahí). Fuera de ese scope el look se rompe.
 *
 * Analytics: cada CTA lleva `data-cta="location:target"` y hay UN listener
 * global que hace `trackEvent('cta_click', {location, target})`. Cero
 * handlers inline (CSP-friendly).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import ComoFunciona from '../components/ComoFunciona.astro';
import Modulos from '../components/Modulos.astro';
import FeatureHighlight from '../components/FeatureHighlight.astro';
import Precios from '../components/Precios.astro';
import TrustedCompanies from '../components/TrustedCompanies.astro';
import Faq from '../components/Faq.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import { BACKEND_BASE } from '../lib/api';

/**
 * JSON-LD SoftwareApplication schema.
 *
 * Google Search Console lo consume para Rich Results (precio + moneda + rating
 * en la SERP). Requiere que los datos SEAN estáticos en el HTML — el crawler
 * NO ejecuta JS antes de indexar, así que un fetch client-side no sirve.
 *
 * Estrategia para evitar drift con el CMS backend:
 *   1. Build-time fetch a /api/public/pricing (Astro top-level await).
 *   2. Si el backend está caído al build, fallback a FALLBACK_PRICES (mismos
 *      valores que Precios.astro renderiza).
 *   3. Cuando Lucas cambia un precio desde admin.tecnyapp.com/planes, un
 *      rebuild Netlify (via webhook — F6) refresca este JSON-LD.
 *
 * priceValidUntil: campo REQUERIDO por Google para offers. Usamos 30 días
 * en el futuro (soft rolling window). Al rebuild se re-calcula. Sin este
 * campo Google puede skippear la offer del rich result.
 */

// Fallbacks matcheados con FALLBACK_PRICES en Precios.astro.
const FALLBACK_PRICES = { starter: 39, pro: 189 };
let prices = FALLBACK_PRICES;
try {
  // Timeout ~5s — si el build no puede fetch en ese lapso, sigue con fallbacks.
  // No queremos que un backend degradado rompa el deploy de la landing.
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), 5000);
  const res = await fetch(`${BACKEND_BASE}/api/public/pricing`, {
    signal: controller.signal,
  });
  clearTimeout(timer);
  if (res.ok) {
    const data = (await res.json()) as { prices?: { starter?: number; pro?: number } };
    if (data?.prices && typeof data.prices.starter === 'number' && typeof data.prices.pro === 'number') {
      prices = { starter: data.prices.starter, pro: data.prices.pro };
    }
  }
} catch {
  // Silent fallback — build sigue con FALLBACK_PRICES.
}

// priceValidUntil: 30 días desde el build. En cada rebuild se refresca.
const priceValidUntil = new Date(Date.now() + 30 * 24 * 60 * 60 * 1000)
  .toISOString()
  .split('T')[0];

const softwareApplicationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Tecny',
  description:
    'Sistema operativo para revendedores de tecnología: cotizador, cuentas corrientes, cajas, envíos, comprobantes con OCR e inventario en una sola pantalla.',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  url: 'https://tecnyapp.com',
  offers: [
    {
      '@type': 'Offer',
      name: 'Starter',
      price: String(prices.starter),
      priceCurrency: 'USD',
      priceValidUntil,
      availability: 'https://schema.org/InStock',
      description: 'Plan para revendedor independiente. 1 usuario, cotizador + usados, financiera básica, 50 OCR/mes.',
    },
    {
      '@type': 'Offer',
      name: 'Pro',
      price: String(prices.pro),
      priceCurrency: 'USD',
      priceValidUntil,
      availability: 'https://schema.org/InStock',
      description: 'Plan para equipos con vendedores. Hasta 10 usuarios, los 7 módulos completos, permisos por usuario, OCR ilimitado.',
    },
  ],
  publisher: {
    '@type': 'Organization',
    name: 'Tecny',
    url: 'https://tecnyapp.com',
    // sameAs pending: agregar cuando IG/LinkedIn oficiales estén activos.
  },
};
---

<BaseLayout>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(softwareApplicationJsonLd)}
    />
  </Fragment>
  <div class="tecny-landing">
    <Nav />
    <Hero />
    <ComoFunciona />
    <Modulos />
    <FeatureHighlight />
    <Precios />
    <TrustedCompanies />
    <Faq />
    <CtaFinal />
    <Contacto />
    <Footer />
  </div>
</BaseLayout>

<script>
  // Analytics globales de la landing — mismo patrón que la versión SPA
  // (Landing.jsx useEffect):
  //   1. landing_view al load + performance mark 'landing-mount'
  //   2. landing_content_ready cuando window.load dispara (proxy para
  //      "todo hidratado" — más simple que trackear 3 fetches paralelos).
  //
  // NOTA: este script vive en la page y se ejecuta 1 vez por page load.
  // En F4 se enriquece con Pixel + GA4 consumiendo los mismos eventos.
  import { trackEvent, markPerformance, measurePerformance } from '../lib/analytics';

  trackEvent('landing_view', { url: window.location.href });
  markPerformance('landing-mount');

  window.addEventListener('load', () => {
    markPerformance('landing-content-ready');
    measurePerformance('landing-content-time', 'landing-mount', 'landing-content-ready');
    trackEvent('landing_content_ready');
  });

  // Wire de CTAs vía delegación global. Todos los <a data-cta="X:Y"> emiten
  // el evento sin necesidad de componentes React. Formato: "location:target"
  // (nav:login, hero:signup, pricing:demo, ...). Optional data-plan para
  // el cta de precios (trial/starter/pro/multi-local).
  document.querySelectorAll<HTMLElement>('[data-cta]').forEach((el) => {
    el.addEventListener('click', () => {
      const raw = el.dataset.cta || '';
      const [location, target] = raw.split(':');
      const plan = el.dataset.plan;
      trackEvent('cta_click', { location, target, ...(plan ? { plan } : {}) });
    });
  });
</script>
